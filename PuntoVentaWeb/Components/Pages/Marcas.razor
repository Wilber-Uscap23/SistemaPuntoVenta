
@page "/marcas"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Marcas - Sistema Punto de Venta</PageTitle>

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Administración de Marcas</h2>
            <p class="text-muted">
                Registra y consulta las marcas de tus productos.
            </p>
        </div>

        <button class="btn btn-primary" @onclick="AbrirFormulario">
            + Nueva Marca
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-success">@mensaje</div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (mostrarFormulario)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                Registrar Nueva Marca
            </div>

            <div class="card-body">

                <EditForm Model="@nuevaMarca"
                          OnValidSubmit="GuardarMarca"
                          FormName="crearMarca">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Nombre de la marca</label>
                        <InputText class="form-control"
                                   @bind-Value="nuevaMarca.Nombre" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <InputText class="form-control"
                                   @bind-Value="nuevaMarca.Descripcion" />
                    </div>

                    <button type="submit"
                            class="btn btn-success"
                            disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar Marca")
                    </button>

                    <button type="button"
                            class="btn btn-secondary ms-2"
                            @onclick="CerrarFormulario">
                        Cancelar
                    </button>

                </EditForm>

            </div>
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Listado de Marcas</h5>
        </div>

        <div class="card-body">

            @if (cargando)
            {
                <p>Cargando marcas...</p>
            }
            else if (marcas.Count == 0)
            {
                <div class="alert alert-info">
                    No hay marcas registradas.
                </div>
            }
            else
            {
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var marca in marcas)
                        {
                            <tr>
                                <td>@marca.IdMarca</td>
                                <td>@marca.Nombre</td>
                                <td>@marca.Descripcion</td>
                                <td>
                                    @if (marca.Estado == true)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactivo
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </div>
    </div>

</div>

@code {

    public class MarcaDto
    {
        public int IdMarca { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? Descripcion { get; set; }
        public bool? Estado { get; set; }
    }

    public class CrearMarcaDto
    {
        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "El nombre es obligatorio.")]
        [System.ComponentModel.DataAnnotations.MaxLength(100)]
        public string Nombre { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.MaxLength(255)]
        public string? Descripcion { get; set; }
    }

    private List<MarcaDto> marcas = new();
    private CrearMarcaDto nuevaMarca = new();

    private bool cargando = true;
    private bool guardando;
    private bool mostrarFormulario;

    private string? mensaje;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await CargarMarcas();
    }

    private async Task CargarMarcas()
    {
        cargando = true;

        try
        {
            marcas = await Http.GetFromJsonAsync<List<MarcaDto>>(
                "api/Marcas") ?? new();

            error = null;
        }
        catch (Exception)
        {
            error = "No se pudieron cargar las marcas. Verifica que la API esté funcionando.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirFormulario()
    {
        nuevaMarca = new CrearMarcaDto();
        mensaje = null;
        error = null;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task GuardarMarca()
    {
        if (guardando)
            return;

        guardando = true;
        mensaje = null;
        error = null;

        try
        {
            var respuesta = await Http.PostAsJsonAsync(
                "api/Marcas", nuevaMarca);

            if (respuesta.IsSuccessStatusCode)
            {
                mostrarFormulario = false;
                nuevaMarca = new CrearMarcaDto();

                await CargarMarcas();

                mensaje = "Marca registrada correctamente.";
            }
            else
            {
                error = $"No se pudo registrar la marca. Código HTTP: {(int)respuesta.StatusCode}.";
            }
        }
        catch (Exception)
        {
            error = "Error de comunicación con la API.";
        }
        finally
        {
            guardando = false;
        }
    }
}
