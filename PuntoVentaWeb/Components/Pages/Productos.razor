
@page "/productos"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using PuntoVentaWeb.Models
@inject HttpClient Http

<PageTitle>Productos - Sistema Punto de Venta</PageTitle>

<div class="container-fluid mt-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Administración de Productos</h2>
            <p class="text-muted">
                Consulta y administra los productos de MySQL.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="AbrirFormulario">
            + Nuevo Producto
        </button>
    </div>

    <!-- MENSAJES -->
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-success">@mensaje</div>
    }

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    <!-- FORMULARIO DE NUEVO PRODUCTO -->
    @if (mostrarFormulario)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Registrar Nuevo Producto</h5>
            </div>

            <div class="card-body">
                <EditForm Model="@nuevoProducto"
                          OnValidSubmit="GuardarProducto"
                          FormName="crearProducto">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Código</label>
                            <InputText class="form-control"
                                       @bind-Value="nuevoProducto.Codigo" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Descripción</label>
                            <InputText class="form-control"
                                       @bind-Value="nuevoProducto.Descripcion" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Precio de costo (Q)</label>
                            <InputNumber class="form-control"
                                         @bind-Value="nuevoProducto.PrecioCosto" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Precio de venta (Q)</label>
                            <InputNumber class="form-control"
                                         @bind-Value="nuevoProducto.PrecioVenta" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Existencia</label>
                            <InputNumber class="form-control"
                                         @bind-Value="nuevoProducto.Existencia" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Marca del producto</label>

                            <InputSelect class="form-select"
                                         @bind-Value="nuevoProducto.IdMarca">
                                <option value="0">-- Selecciona una marca --</option>

                                @foreach (var marca in marcas.Where(m => m.Estado == true))
                                {
                                    <option value="@marca.IdMarca">
                                        @marca.Nombre
                                    </option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">URL de imagen (opcional)</label>
                            <InputText class="form-control"
                                       @bind-Value="nuevoProducto.ImagenUrl" />
                        </div>

                    </div>

                    <div class="mt-4">
                        <button type="submit"
                                class="btn btn-success"
                                disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar Producto")
                        </button>

                        <button type="button"
                                class="btn btn-secondary ms-2"
                                @onclick="CerrarFormulario">
                            Cancelar
                        </button>
                    </div>

                </EditForm>
            </div>
        </div>
    }

    <!-- FORMULARIO PARA EDITAR PRODUCTO -->
    @if (mostrarEdicion)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    Editar Producto #@idProductoEditar
                </h5>
            </div>

            <div class="card-body">

                <EditForm Model="@productoEditar"
                          OnValidSubmit="GuardarEdicion"
                          FormName="editarProducto">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Código</label>
                            <InputText class="form-control"
                                       @bind-Value="productoEditar.Codigo" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Descripción</label>
                            <InputText class="form-control"
                                       @bind-Value="productoEditar.Descripcion" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Precio de costo (Q)</label>
                            <InputNumber class="form-control"
                                         @bind-Value="productoEditar.PrecioCosto" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Precio de venta (Q)</label>
                            <InputNumber class="form-control"
                                         @bind-Value="productoEditar.PrecioVenta" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Existencia</label>
                            <InputNumber class="form-control"
                                         @bind-Value="productoEditar.Existencia" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Marca del producto</label>

                            <InputSelect class="form-select"
                                         @bind-Value="productoEditar.IdMarca">
                                <option value="0">-- Selecciona una marca --</option>

                                @foreach (var marca in marcas.Where(m =>
                                    m.Estado == true ||
                                    m.IdMarca == productoEditar.IdMarca))
                                {
                                    <option value="@marca.IdMarca">
                                        @marca.Nombre
                                    </option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">URL de imagen (opcional)</label>
                            <InputText class="form-control"
                                       @bind-Value="productoEditar.ImagenUrl" />
                        </div>

                    </div>

                    <div class="mt-4">
                        <button type="submit"
                                class="btn btn-success"
                                disabled="@actualizando">
                            @(actualizando ? "Actualizando..." : "Guardar Cambios")
                        </button>

                        <button type="button"
                                class="btn btn-secondary ms-2"
                                @onclick="CerrarEdicion">
                            Cancelar
                        </button>
                    </div>

                </EditForm>

            </div>
        </div>
    }

    <!-- LISTADO DE PRODUCTOS -->
    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Listado de Productos</h5>
        </div>

        <div class="card-body">

            @if (cargando)
            {
                <p>Cargando productos...</p>
            }
            else if (productos.Count == 0)
            {
                <div class="alert alert-info">
                    No hay productos registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">

                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Código</th>
                                <th>Descripción</th>
                                <th>Marca</th>
                                <th>Precio</th>
                                <th>Existencia</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var producto in productos)
                            {
                                <tr>
                                    <td>@producto.IdProducto</td>
                                    <td>@producto.Codigo</td>
                                    <td>@producto.Descripcion</td>
                                    <td>@ObtenerNombreMarca(producto.IdMarca)</td>
                                    <td>@($"Q{producto.PrecioVenta:N2}")</td>
                                    <td>@producto.Existencia</td>

                                    <td>
                                        @if (producto.Estado == true)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-warning btn-sm"
                                                @onclick="() => AbrirEdicion(producto)">
                                            Editar
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm ms-1"
                                                disabled>
                                            Desactivar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {

    // LISTADOS
    private List<ProductoDto> productos = new();
    private List<MarcaDto> marcas = new();

    // MODELOS DE FORMULARIOS
    private CrearProductoDto nuevoProducto = new();
    private ActualizarProductoDto productoEditar = new();

    // ESTADOS
    private bool cargando = true;
    private bool guardando = false;
    private bool mostrarFormulario = false;
    private bool mostrarEdicion = false;
    private bool actualizando = false;

    private int idProductoEditar = 0;

    // MENSAJES
    private string? mensaje;
    private string? error;

    // CARGA INICIAL
    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
        await CargarMarcas();
    }

    // CARGAR PRODUCTOS
    private async Task CargarProductos()
    {
        cargando = true;

        try
        {
            productos = await Http.GetFromJsonAsync<List<ProductoDto>>(
                "api/Productos") ?? new();
        }
        catch (Exception)
        {
            productos = new();
            error = "No se pudieron cargar los productos. Verifica la API.";
        }
        finally
        {
            cargando = false;
        }
    }

    // CARGAR MARCAS
    private async Task CargarMarcas()
    {
        try
        {
            marcas = await Http.GetFromJsonAsync<List<MarcaDto>>(
                "api/Marcas") ?? new();
        }
        catch (Exception)
        {
            marcas = new();
            error = "No se pudieron cargar las marcas. Verifica la API.";
        }
    }

    // OBTENER NOMBRE DE MARCA
    private string ObtenerNombreMarca(int idMarca)
    {
        var marca = marcas.FirstOrDefault(m => m.IdMarca == idMarca);
        return marca?.Nombre ?? "Marca no encontrada";
    }

    // ABRIR FORMULARIO DE REGISTRO
    private void AbrirFormulario()
    {
        nuevoProducto = new CrearProductoDto
        {
            IdMarca = 0
        };

        mostrarEdicion = false;
        mostrarFormulario = true;

        mensaje = null;
        error = null;
    }

    // CERRAR FORMULARIO DE REGISTRO
    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    // GUARDAR PRODUCTO NUEVO
    private async Task GuardarProducto()
    {
        if (guardando)
            return;

        guardando = true;
        mensaje = null;
        error = null;

        try
        {
            bool marcaValida = marcas.Any(m =>
                m.IdMarca == nuevoProducto.IdMarca &&
                m.Estado == true);

            if (!marcaValida)
            {
                error = "Debes seleccionar una marca válida.";
                return;
            }

            var respuesta = await Http.PostAsJsonAsync(
                "api/Productos", nuevoProducto);

            if (respuesta.IsSuccessStatusCode)
            {
                mostrarFormulario = false;
                nuevoProducto = new CrearProductoDto();

                await CargarProductos();

                if (string.IsNullOrEmpty(error))
                {
                    mensaje = "Producto registrado correctamente.";
                }
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                error = $"No se pudo registrar el producto. " +
                        $"HTTP {(int)respuesta.StatusCode}. {detalle}";
            }
        }
        catch (Exception)
        {
            error = "No se pudo conectar con la API.";
        }
        finally
        {
            guardando = false;
        }
    }

    // ABRIR EDICIÓN
    private void AbrirEdicion(ProductoDto producto)
    {
        idProductoEditar = producto.IdProducto;

        productoEditar = new ActualizarProductoDto
        {
            Codigo = producto.Codigo,
            Descripcion = producto.Descripcion,
            PrecioCosto = producto.PrecioCosto,
            PrecioVenta = producto.PrecioVenta,
            Existencia = producto.Existencia,
            IdMarca = producto.IdMarca,
            ImagenUrl = producto.ImagenUrl
        };

        mostrarFormulario = false;
        mostrarEdicion = true;

        mensaje = null;
        error = null;
    }

    // CANCELAR EDICIÓN
    private void CerrarEdicion()
    {
        mostrarEdicion = false;
        idProductoEditar = 0;
    }

    // GUARDAR CAMBIOS DEL PRODUCTO
    private async Task GuardarEdicion()
    {
        if (actualizando)
            return;

        actualizando = true;
        mensaje = null;
        error = null;

        try
        {
            var respuesta = await Http.PutAsJsonAsync(
                $"api/Productos/{idProductoEditar}",
                productoEditar);

            if (respuesta.IsSuccessStatusCode)
            {
                mostrarEdicion = false;
                idProductoEditar = 0;

                await CargarProductos();

                if (string.IsNullOrEmpty(error))
                {
                    mensaje = "Producto actualizado correctamente.";
                }
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();

                error = $"No se pudo actualizar el producto. " +
                        $"HTTP {(int)respuesta.StatusCode}. {detalle}";
            }
        }
        catch (Exception)
        {
            error = "No fue posible conectar con la API.";
        }
        finally
        {
            actualizando = false;
        }
    }
}
